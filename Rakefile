# Add your own tasks in files placed in lib/tasks ending in .rake,
# for example lib/tasks/capistrano.rake, and they will automatically be available to Rake.
# "네가 직접 만들고 싶은 작업이 있다면,
#  Rakefile을 직접 수정하지 말고 lib/tasks 폴더 안에 .rake 확장자로 파일을 만들어라.
#  그럼 내가 알아서 가져다 쓸게." 라는 뜻입니다.

require_relative "config/application"

Rails.application.load_tasks

# 이 파일이 있어서 가능한 것들:
# 터미널에서 자주 쓰는 명령어들이 바로 이 Rakefile을 통해 실행됩니다.
# bin/rails db:migrate (데이터베이스 마이그레이션)
# bin/rails routes (라우팅 표 확인)
# bin/rails test (테스트 실행)
