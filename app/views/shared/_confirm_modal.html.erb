<dialog id="confirm-modal" class="confirm-modal">
  <!-- Wrapper for safe Flexbox centering -->
  <div class="confirm-modal-wrapper">
    <div class="confirm-modal-content">
      <h3 id="confirm-modal-title">Confirm Action</h3>
      <p id="confirm-modal-message">Are you sure you want to proceed?</p>
      <div class="confirm-modal-actions">
        <button type="button" id="confirm-modal-cancel" class="button secondary">Cancel</button>
        <button type="button" id="confirm-modal-proceed" class="button danger">Confirm</button>
      </div>
    </div>
  </div>
</dialog>
