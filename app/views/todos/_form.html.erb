<%= form_with(model: todo, class: "todo-form", data: { turbo_frame: "_top" }) do |form| %>

  <% if todo.errors.any? %>
    <div class="toast alert" style="position: static; margin-bottom: 2rem; transform: none; animation: none;">
      <div class="toast-content" style="width: 100%;">
        <h4 style="margin: 0 0 0.5rem 0;"><%= pluralize(todo.errors.count, "error") %> prohibited this todo from being saved:</h4>
        <ul style="margin: 0; padding-left: 1.5rem;">
          <% todo.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, class: "input-field", placeholder: "What needs to be done?" %>
  </div>

  <%= render 'shared/rich_editor',
      form: form,
      field: :description,
      label: "Description",
      placeholder: "Add details (optional)",
      readonly: false %>

  <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
    <div class="field" style="flex: 1; min-width: 200px;">
      <%= form.label :due_date %>
      <%= form.datetime_field :due_date, class: "input-field", onclick: "this.showPicker()" %>
    </div>

    <div class="field priority-field" style="flex: 1; min-width: 200px;">
      <%= form.label :priority %>
      <div class="priority-button-group">
        <% Todo.priorities.keys.each do |priority| %>
          <%= form.radio_button :priority, priority,
              id: "todo_priority_#{priority}",
              class: "priority-radio-input" %>
          <%= form.label "priority_#{priority}",
              priority.humanize,
              class: "priority-button priority-#{priority}" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="field checkbox" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem;">
    <%= form.check_box :completed, class: "checkbox-input", style: "width: 20px; height: 20px;" %>
    <%= form.label :completed, style: "margin: 0;" %>
  </div>

  <div class="confirm-modal-actions">
    <% if todo.new_record? %>
      <button type="button" class="button secondary" onclick="this.closest('dialog').close()">Cancel</button>
    <% else %>
      <%= link_to "Cancel", todo, class: "button secondary" %>
    <% end %>
    <%= form.submit (todo.new_record? ? "Add" : "Save"), class: "button success" %>
  </div>
<% end %>
