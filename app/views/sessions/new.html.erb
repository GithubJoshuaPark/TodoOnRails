<div class="auth-container">
  <div class="auth-header">
    <%= image_tag "rails_todo_header.png", class: "auth-logo" %>
  </div>

  <h1 class="auth-title">Login</h1>

  <% if flash[:alert] %>
    <div class="auth-alert">
      <i class="bi bi-exclamation-circle"></i>
      <span><%= flash[:alert] %></span>
    </div>
  <% end %>

  <%= form_with url: login_path, local: true, class: "auth-form" do |form| %>
    <div class="field">
      <%= form.label :login_id, "Login ID" %>
      <div class="input-with-icon">
        <i class="bi bi-person"></i>
        <%= form.text_field :login_id, class: "input-field", placeholder: "Enter your ID", autocomplete: "username" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :password, "Password" %>
      <div class="input-with-icon">
        <i class="bi bi-lock"></i>
        <%= form.password_field :password, class: "input-field", placeholder: "Enter your password", autocomplete: "current-password" %>
      </div>
    </div>

    <div class="auth-actions">
      <%= form.submit "Login", class: "button success full-width" %>
    </div>
  <% end %>

  <div class="auth-footer">
    Don't have an account? <%= link_to "Sign Up", signup_path, class: "auth-link" %>
  </div>
</div>
