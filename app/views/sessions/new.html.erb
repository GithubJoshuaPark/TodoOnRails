<div class="auth-container">
  <h1 style="text-align: center; margin-bottom: 2rem;">Login</h1>

  <% if flash[:alert] %>
    <div class="toast alert" style="position: static; margin-bottom: 2rem; transform: none; animation: none;">
      <div class="toast-content"><%= flash[:alert] %></div>
    </div>
  <% end %>

  <%= form_with url: login_path, local: true do |form| %>
    <div class="field">
      <%= form.label :login_id, "Login ID" %>
      <%= form.text_field :login_id, class: "input-field", placeholder: "Enter your ID" %>
    </div>

    <div class="field">
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, class: "input-field", placeholder: "Enter your password" %>
    </div>

    <div class="actions" style="margin-top: 2rem;">
      <%= form.submit "Login", class: "button primary", style: "width: 100%;" %>
    </div>
  <% end %>

  <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem; color: var(--text-muted);">
    Don't have an account? <%= link_to "Sign Up", signup_path, style: "color: var(--accent-color); font-weight: bold; text-decoration: underline;" %>
  </div>
</div>
