<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Todo On Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Todo On Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "fonts", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="page-transition"
        data-action="turbo:before-visit->page-transition#beforeVisit
                     turbo:before-render->page-transition#beforeRender
                     turbo:render->page-transition#render">

    <header class="app-header">
      <nav class="main-nav" data-controller="navbar">
        <div class="logo" style="display: flex; align-items: center; gap: 0.5rem;">
          <%= image_tag "rails_todo_header.png", style: "width: 30px; height: 30px; object-fit: cover; border-radius: 6px; box-shadow: 0 2px 15px rgba(255,255,255,0.1); transition: transform 0.3s;" %>
          <%= link_to "TodoOnRails", root_path, style: "display: flex; align-items: center; height: 30px; line-height: 1;" %>
        </div>

        <button class="hamburger-btn" data-action="click->navbar#toggle" aria-label="Toggle navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="nav-links" id="nav-links" data-navbar-target="menu">
          <% if logged_in? %>
            <%= link_to "My Todos", todos_path, class: "nav-item" %>
            <%= link_to "About", about_path, class: "nav-item" %>

            <div class="user-menu">
              <button class="username" data-action="click->navbar#toggleProfile">
                <% if current_user.avatar.attached? %>
                  <%= image_tag current_user.avatar, class: "username-avatar" %>
                <% else %>
                  <i class="bi bi-person-circle username-avatar-fallback"></i>
                <% end %>
                <span class="username-text"><%= current_user.user_name.presence || current_user.login_id %></span>
                <i class="bi bi-chevron-down username-arrow"></i>
              </button>

              <div id="profile-dropdown" class="profile-dropdown">
                <%= link_to edit_user_path(current_user), class: "dropdown-item" do %>
                  <i class="bi bi-person"></i>
                  <span>Profile</span>
                <% end %>
                <%= button_to logout_path, method: :delete, class: "dropdown-item dropdown-item-danger" do %>
                  <i class="bi bi-box-arrow-right"></i>
                  <span>Logout</span>
                <% end %>
              </div>
            </div>
          <% else %>
            <%= link_to "About", about_path, class: "nav-item" %>
            <%= link_to login_path, class: "nav-item-auth" do %>
              <i class="bi bi-box-arrow-in-right"></i>
              <span>Login</span>
            <% end %>
            <%= link_to signup_path, class: "button small primary nav-signup" do %>
              <i class="bi bi-person-plus"></i>
              <span>Sign Up</span>
            <% end %>
          <% end %>
        </div>
      </nav>
    </header>
    <main class="<%= params[:view_mode] == 'kanban' ? 'container-fluid' : 'container' %>">
      <%= yield %>
    </main>

    <footer class="app-footer">
      <div class="footer-content">
        <div class="footer-copyright">
          © 2026 TodoOnRails
        </div>
        <div class="footer-links">
          <p><%= link_to "Privacy Policy", privacy_path, class: "footer-link" %></p>
          <p><%= link_to "Terms of Service", terms_path, class: "footer-link" %></p>
          <p><a href="mailto:soromiso@gmail.com" class="footer-email" target="_blank">Contact</a></p>
        </div>
      </div>
    </footer>

    <div class="toast-container">
      <% flash.each do |key, value| %>
        <div class="toast <%= key %>" data-controller="toast">
          <div class="toast-content"><%= value %></div>
          <button data-action="toast#close" class="toast-close">&times;</button>
        </div>
      <% end %>
    </div>

    <%= render "shared/confirm_modal" %>
    <%= turbo_frame_tag "modal" %>
  </body>
</html>
